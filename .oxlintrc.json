{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jest", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/style-prop-object": "off"
  },
  "ignorePatterns": [
    ".expo/**",
    "dist/**",
    "coverage/**",
    ".agents/**",
    "services/**",
    "supabase/**"
  ]
}
